# Copy to deploy/.env.test (gitignored) on the LAN test VM and adjust; use with
#   docker compose --env-file deploy/.env.test -f deploy/compose.test.yml ...
# Generate the key with: openssl rand -base64 32
HOJE_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
POSTGRES_PASSWORD=change-me

# Public URL as seen by the browser (used for links in emails and the Origin check).
HOJE_PUBLIC_URL=http://192.168.10.189:8190

# Published ports on the VM
HOJE_TEST_PORT=8190
HOJE_MAILPIT_PORT=8191

# Optional: prebuilt images instead of building on the VM
# HOJE_API_IMAGE=hoje-test/api:local
# HOJE_WEB_IMAGE=hoje-test/web:local
