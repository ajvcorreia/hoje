# Hoje web tier: static SPA + reverse proxy to the API.
# SITE_ADDRESS: ":8080" (plain HTTP; production runs behind Nginx Proxy Manager which terminates
# TLS) or a domain (Caddy then obtains certificates itself).
# API_UPSTREAM: defaults to api:8000.
# TRUSTED_PROXIES: space-separated IPs/CIDRs of reverse proxies in front of this container
# (e.g. Nginx Proxy Manager). Only their X-Forwarded-For is believed; for any other peer the
# connecting address is the client. Defaults to the private ranges.
{
	admin off
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
	log {
		output stdout
		format json
	}
}

# Local-only health endpoint for the container HEALTHCHECK.
http://127.0.0.1:2020 {
	bind 127.0.0.1
	handle /caddy-health {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}

(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

{$SITE_ADDRESS} {
	# Access log: JSON with the resolved client_ip, minus anything that carries a credential or a
	# search term (session / CSRF tokens in headers, Set-Cookie, the query string).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>X-Csrf-Token delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri regexp "\?.*" ""
			}
		}
	}

	import security_headers

	# Error responses (e.g. a missing /assets/ file) bypass the route above, so repeat the
	# headers here and never leak the server banner.
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# API and probes. flush_interval -1 keeps the SSE stream unbuffered.
	# Request bodies are tiny JSON documents: refuse anything over 1 MB with 413 before it reaches
	# the API (which enforces its own 1 MiB cap as defence in depth).
	handle /api/* {
		# A declared Content-Length over the cap is answered here: left to request_body alone,
		# the proxy would surface the aborted upload as 502. request_body below still cuts off
		# chunked bodies (and a lying Content-Length) with 413.
		@too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1000000`
		respond @too_large "Request body too large" 413 {
			close
		}
		request_body {
			max_size 1MB
		}
		reverse_proxy {$API_UPSTREAM:api:8000} {
			# Overwrites any client-supplied value; the API trusts this header (see client_ip).
			header_up X-Real-IP {client_ip}
			flush_interval -1
			header_down -Server
		}
	}
	handle /healthz {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			# Overwrites any client-supplied value; the API trusts this header (see client_ip).
			header_up X-Real-IP {client_ip}
			header_down -Server
		}
	}
	handle /readyz {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			# Overwrites any client-supplied value; the API trusts this header (see client_ip).
			header_up X-Real-IP {client_ip}
			header_down -Server
		}
	}

	# Static SPA. Compression is enabled per static handle only: encoding /api/* would buffer SSE.
	root * /srv

	# Hashed build output: cache forever.
	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /manifest.webmanifest {
		encode zstd gzip
		header Content-Type "application/manifest+json"
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else falls back to index.html (client-side routing).
	handle {
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
