# Production settings. Copy to deploy/.env (gitignored) and edit every value:
#   cp deploy/prod.env.example deploy/.env
# Use it with: docker compose -f deploy/compose.prod.yml --env-file deploy/.env ...
# Do not quote values and do not put spaces around "=".

# --- Images (Docker Hub) ----------------------------------------------------------------
# Your Docker Hub namespace (user or organisation) that owns hoje-api and hoje-web.
DOCKERHUB_NAMESPACE=your-dockerhub-user
# Image tag. In production pin a release version (1.0.0) or sha-<short>, not "latest": a moving
# tag means whatever is pushed to it next is what `pull` + `up` runs.
HOJE_TAG=1.1.0

# --- Application ------------------------------------------------------------------------
HOJE_ENV=production
# The https URL users type in the browser (the Nginx Proxy Manager domain). Used for links in
# emails and the Origin check, so it must match exactly (scheme + host, no trailing slash).
HOJE_PUBLIC_URL=https://hoje.example.com
# 32 random bytes, base64. Encrypts TOTP secrets: changing it invalidates enrolled
# authenticators. Generate once and back it up: openssl rand -base64 32
HOJE_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
HOJE_LOG_LEVEL=INFO
# Registration is always open until the first account exists; keep this false afterwards.
HOJE_ALLOW_REGISTRATION=false
# Guards the very first registration: until the first account exists, only someone who knows
# this token can create it. Generate with: openssl rand -base64 24 (at least 16 characters).
# It is ignored once a user exists, so you may remove it after registering.
HOJE_SETUP_TOKEN=
HOJE_WORKER_INTERVAL_SECONDS=60

# --- Database ---------------------------------------------------------------------------
# Used inside a connection URL: stick to letters and digits (openssl rand -hex 24).
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24

# --- Email (reminders and password reset) -----------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
# Port 587: STARTTLS=true, TLS=false. Port 465 (implicit TLS): STARTTLS=false, TLS=true.
SMTP_STARTTLS=true
SMTP_TLS=false
SMTP_FROM=hoje@example.com

# --- Network: how Nginx Proxy Manager reaches hoje-web ----------------------------------
# Host interface the web port is published on. 127.0.0.1 when NPM runs natively or with host
# networking on this machine; the LAN address (or 0.0.0.0, firewalled!) when NPM is elsewhere.
HOJE_BIND=127.0.0.1
HOJE_HTTP_PORT=8080
# REQUIRED (compose refuses to start without it). Space-separated IPs/CIDRs of NPM as seen by
# hoje-web. Only these may supply X-Forwarded-For; everyone else is identified by the address
# they connect from. Use the narrowest value for your layout:
#   A. NPM is a container, hoje-web joined to its network (compose.prod.proxy-network.yml):
#        NPM's IP on that network, as /32 (pin it with ipv4_address in NPM's compose file):
#          docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' <npm container>
#        or, if only trusted containers share that network, the network subnet:
#          docker network inspect <HOJE_PROXY_NETWORK> -f '{{(index .IPAM.Config 0).Subnet}}'
#   B. NPM runs natively or with host networking on THIS machine (HOJE_BIND=127.0.0.1):
#        it reaches the published port through Docker, so hoje-web sees the gateway of the
#        hoje_edge network, not 127.0.0.1:
#          docker network inspect hoje_edge -f '{{(index .IPAM.Config 0).Gateway}}'   (as /32)
#        (the network exists after the first `up`; run `docker compose ... up -d` once, read the
#        gateway, set it here and `up -d` again. Check the logged client_ip afterwards.)
#   C. NPM is on another machine: that machine's LAN IP, as /32 (e.g. 192.168.1.10/32).
# Do not use 0.0.0.0/0 or a whole private range unless you accept that any host that can reach
# hoje-web may choose its own client IP (and so dodge the per-IP lockout).
TRUSTED_PROXIES=172.18.0.2/32
# Only with -f deploy/compose.prod.proxy-network.yml: the Docker network NPM is attached to.
#HOJE_PROXY_NETWORK=npm_default

# --- Backups ----------------------------------------------------------------------------
# The worker backs up the database itself (pg_dump) into its /backups volume; there is no
# separate backup container. Status and "Back up now" are in Settings > Backups (owner only).
HOJE_BACKUP_ENABLED=true
# Local hour (0-23, in TZ) of the nightly dump, and how many days of dumps to keep (1-3650).
BACKUP_SCHEDULE_HOUR=2
BACKUP_KEEP_DAYS=14
# Empty = Docker named volume "hoje_backups". Or an absolute host directory (previously this
# was called HOJE_BACKUP_DIR). It must be writable by uid 10001: sudo chown 10001:10001 <dir>
#HOJE_BACKUP_DIR_HOST=/srv/hoje/backups
# Time zone of the containers (backup schedule, log timestamps), e.g. Europe/Lisbon.
TZ=UTC
