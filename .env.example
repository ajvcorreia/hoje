# Core environment
HOJE_ENV=production
HOJE_LOG_LEVEL=INFO

# Database
HOJE_DATABASE_URL=postgresql+asyncpg://hoje:change-me@db:5432/hoje

# Security & TOTP encryption
# Generate with: openssl rand -base64 32
HOJE_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
HOJE_PUBLIC_URL=https://hoje.example.com
HOJE_ALLOW_REGISTRATION=false
# Optional (>= 16 chars): required to register the first account. openssl rand -base64 24
#HOJE_SETUP_TOKEN=
# Trust X-Real-IP set by hoje-web for the login throttle (API must only be reachable via hoje-web)
HOJE_TRUST_REAL_IP_HEADER=true
HOJE_INSECURE_COOKIES=false

# Email / SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_STARTTLS=true
SMTP_TLS=false
SMTP_FROM=noreply@hoje.example.com

# Web / Caddy reverse proxy
# Domain for automatic HTTPS in production; use :8080 for plain HTTP (test VM)
SITE_ADDRESS=hoje.example.com
API_UPSTREAM=api:8000

# PostgreSQL database
POSTGRES_PASSWORD=change-me

# Backup configuration
BACKUP_KEEP_DAYS=30
BACKUP_SCHEDULE_HOUR=2

# Docker / Deployment
DOCKERHUB_NAMESPACE=change-me
HOJE_TAG=latest

# Worker configuration
HOJE_WORKER_INTERVAL_SECONDS=60
