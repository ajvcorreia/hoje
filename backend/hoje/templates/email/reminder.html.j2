{% extends "base.html.j2" %}
{% block content %}
                <p style="margin:0 0 8px;">This is your reminder for:</p>
                <p style="margin:0 0 16px;font-size:18px;font-weight:600;">{{ title }}</p>
                <p style="margin:0 0 4px;"><strong>When:</strong> {{ when_long }}</p>
{% if time_range %}
                <p style="margin:0 0 4px;"><strong>Time:</strong> {{ time_range }}</p>
{% endif %}
                <p style="margin:0 0 16px;"><strong>Category:</strong> {{ category }}</p>
                <p style="margin:0;"><a href="{{ open_url }}" style="display:inline-block;padding:10px 18px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:6px;">Open Hoje</a></p>
{% endblock %}
