{% extends "base.html.j2" %}
{% block content %}
                <p style="margin:0 0 16px;font-weight:600;">{{ what }}</p>
                <p style="margin:0 0 16px;">When: {{ when }}<br>From IP address: {{ ip }}</p>
                <p style="margin:0 0 16px;">If this was you, there is nothing to do.</p>
                <p style="margin:0 0 16px;">If this was not you, someone else may have access to your account. Reset your password right away:</p>
                <p style="margin:0;"><a href="{{ reset_url }}" style="display:inline-block;padding:10px 18px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:6px;">Reset my password</a></p>
{% endblock %}
