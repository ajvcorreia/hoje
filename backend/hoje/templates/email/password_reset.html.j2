{% extends "base.html.j2" %}
{% block content %}
                <p style="margin:0 0 16px;">Someone asked to reset the password for your {{ app_name }} account. If that was you, use the button below to choose a new password.</p>
                <p style="margin:0 0 16px;"><a href="{{ reset_url }}" style="display:inline-block;padding:10px 18px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:6px;">Choose a new password</a></p>
                <p style="margin:0 0 16px;">The link works once and expires in {{ expires_minutes }} minutes. If the button does not work, copy this address into your browser:</p>
                <p style="margin:0 0 16px;word-break:break-all;font-size:14px;">{{ reset_url }}</p>
                <p style="margin:0;">If you did not ask for this, you can ignore this email. Your password will not change.</p>
{% endblock %}
