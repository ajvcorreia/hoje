{% extends "base.html.j2" %}
{% macro row(lead, item) %}
                    <tr>
                      <td style="padding:0 12px 8px 0;color:#57534e;white-space:nowrap;vertical-align:top;line-height:20px;">{{ lead }}</td>
                      <td style="padding:0 12px 8px 0;white-space:nowrap;vertical-align:top;line-height:20px;">
{% if item.category %}
                        <span style="display:inline-block;min-width:80px;padding:0 8px;border-radius:10px;font-size:12px;text-align:center;background:{{ item.chip_fill }};color:{{ item.chip_text }};">{{ item.category }}</span>
{% endif %}
                      </td>
                      <td style="padding:0 0 8px;vertical-align:top;line-height:20px;"><strong>{{ item.title }}</strong></td>
                    </tr>
{% endmacro %}
{% macro event_list(items, more) %}
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 8px;border-collapse:collapse;">
{% for item in items %}
{{ row(item.when, item) }}
{% endfor %}
                </table>
{% if more %}
                <p style="margin:0 0 8px;color:#57534e;">...and {{ more }} more</p>
{% endif %}
{% endmacro %}
{% macro section_title(text) %}
                <h2 style="margin:0 0 10px;font-size:16px;font-weight:700;text-decoration:underline;">{{ text }}</h2>
{% endmacro %}
{% block content %}
{% set ns = namespace(n=0) %}
                <p style="margin:0 0 16px;font-size:18px;font-weight:600;">Daily summary for {{ heading_date }}</p>
{% if test %}
                <p style="margin:0 0 16px;color:#57534e;">This is a test summary, sent because you asked for one.</p>
{% endif %}
{% if data.is_empty %}
                <p style="margin:0 0 16px;">Nothing is scheduled today or tomorrow, and nothing changed since {{ data.since_label }}.</p>
{% endif %}
{% if data.todos %}
{% set ns.n = ns.n + 1 %}
{{ section_title('To-dos due') }}
                <ul style="margin:0 0 8px;padding:0;list-style:none;">
{% for todo in data.todos %}
                  <li style="margin:0 0 8px;">
                    <span style="color:{% if todo.overdue %}#b91c1c{% else %}#57534e{% endif %};">{{ todo.due }}</span><br>
                    <strong>{{ todo.title }}</strong>
                  </li>
{% endfor %}
                </ul>
{% if data.todos_more %}
                <p style="margin:0 0 8px;color:#57534e;">...and {{ data.todos_more }} more</p>
{% endif %}
{% endif %}
{% if data.today_items %}
{% if ns.n %}
                <hr style="border:0;border-top:1px solid #d6d3d1;margin:20px 0;">
{% endif %}
{% set ns.n = ns.n + 1 %}
{{ section_title('Today') }}
{{ event_list(data.today_items, data.today_more) }}
{% endif %}
{% if data.birthdays or data.holidays %}
{% if ns.n %}
                <hr style="border:0;border-top:1px solid #d6d3d1;margin:20px 0;">
{% endif %}
{% set ns.n = ns.n + 1 %}
{{ section_title('Birthdays & holidays today') }}
                <ul style="margin:0 0 8px;padding:0;list-style:none;">
{% for holiday in data.holidays %}
                  <li style="margin:0 0 8px;"><strong>{{ holiday.name }}</strong> <span style="color:#57534e;">({{ holiday.calendar }}{% if holiday.non_working %}, non-working day{% endif %})</span></li>
{% endfor %}
{% for birthday in data.birthdays %}
                  <li style="margin:0 0 8px;"><span style="font-size:18px;line-height:20px;vertical-align:middle;">🎂</span>&nbsp; <strong>{{ birthday.name }}</strong>'s birthday{% if birthday.age is not none %} <span style="color:#57534e;">({{ birthday.age }})</span>{% endif %}</li>
{% endfor %}
                </ul>
{% endif %}
{% if data.tomorrow_items %}
{% if ns.n %}
                <hr style="border:0;border-top:1px solid #d6d3d1;margin:20px 0;">
{% endif %}
{% set ns.n = ns.n + 1 %}
{{ section_title('Tomorrow') }}
                <p style="margin:0 0 8px;color:#57534e;">{{ tomorrow_date }}</p>
{{ event_list(data.tomorrow_items, data.tomorrow_more) }}
{% endif %}
{% if data.changes %}
{% if ns.n %}
                <hr style="border:0;border-top:1px solid #d6d3d1;margin:20px 0;">
{% endif %}
{% set ns.n = ns.n + 1 %}
{{ section_title('Changes since ' ~ data.since_label) }}
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 8px;border-collapse:collapse;">
{% for change in data.changes %}
{{ row(change.what ~ ' · ' ~ change.item.when, change.item) }}
{% endfor %}
                </table>
{% if data.changes_more %}
                <p style="margin:0 0 8px;color:#57534e;">...and {{ data.changes_more }} more</p>
{% endif %}
{% endif %}
                <p style="margin:24px 0 0;"><a href="{{ open_url }}" style="display:inline-block;padding:10px 18px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:6px;">Open Hoje</a></p>
{% endblock %}
